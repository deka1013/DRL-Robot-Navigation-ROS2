# Source this file from Bash: source /path/to/project/src/test.env
export DRLNAV_BASE_PATH="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-1}"
export TURTLEBOT3_MODEL="${TURTLEBOT3_MODEL:-waffle}"
# Work around intermittent fused addmm CUDA output corruption observed on
# this WSL2 / RTX 3050 / PyTorch cu130 environment; retain CUDA acceleration.
export DISABLE_ADDMM_CUDA_LT="${DISABLE_ADDMM_CUDA_LT:-1}"

if [ ! -f /opt/ros/humble/setup.bash ]; then
    echo "ROS 2 Humble is missing: /opt/ros/humble/setup.bash" >&2
    return 1
fi
source /opt/ros/humble/setup.bash || return 1
if [ ! -f "$DRLNAV_BASE_PATH/install/setup.bash" ]; then
    echo "Build the workspace first: cd $DRLNAV_BASE_PATH && colcon build" >&2
    return 1
fi
source "$DRLNAV_BASE_PATH/install/setup.bash" || return 1

_drl_models="$DRLNAV_BASE_PATH/src/turtlebot3_simulations/turtlebot3_gazebo/models"
case ":${GAZEBO_MODEL_PATH:-}:" in
    *":$_drl_models:"*) ;;
    *) export GAZEBO_MODEL_PATH="$_drl_models${GAZEBO_MODEL_PATH:+:$GAZEBO_MODEL_PATH}" ;;
esac
unset _drl_models
